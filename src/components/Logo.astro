---
// Brand lockup: the client's emblem (cut out with _scripts/logo_cutout.py: globe kept solid, no keyed holes)
// plus a live-text wordmark. The text block is optically centred on the emblem (see .lockup-text).
import { Image } from 'astro:assets';
import emblem from '../assets/brand/emblem.png';

interface Props {
  /** 'auto' follows the page theme; 'dark' forces the on-navy colours (menu, footer). */
  tone?: 'auto' | 'dark';
  size?: 'sm' | 'lg';
  tagline?: boolean;
  class?: string;
}
const { tone = 'auto', size = 'sm', tagline = false, class: cls = '' } = Astro.props;
const lg = size === 'lg';
---
<span class:list={['lockup inline-flex items-center', lg ? 'gap-3.5' : 'gap-2', tone === 'dark' && 'on-dark', cls]}>
  <Image
    src={emblem}
    alt=""
    height={lg ? 68 : 40}
    densities={[1, 2]}
    loading="eager"
    class:list={['w-auto shrink-0', lg ? 'h-[68px]' : 'h-10']}
  />
  <span class:list={['lockup-text flex flex-col', lg && 'is-lg']}>
    <span class:list={['font-[family-name:var(--font-brand)] font-bold leading-none tracking-[0.01em] whitespace-nowrap', lg ? 'text-[2.1rem]' : 'text-[1.28rem]']}>
      <span class="wm-gold">Ocean</span><span class="wm-ink"> Prime</span>
    </span>
    <span
      class:list={['flex items-center gap-1.5 font-semibold uppercase leading-none wm-ink opacity-80', lg ? 'mt-2 text-[0.72rem] tracking-[0.26em]' : 'mt-[5px] text-[0.5rem] tracking-[0.24em]']}
      aria-hidden="true"
    >
      <span class="h-px flex-1 bg-gold/70"></span><span class="tag-word">Sea Food Exports</span><span class="h-px flex-1 bg-gold/70"></span>
    </span>
    {tagline && <span class:list={['mt-2 font-medium leading-none tracking-[0.02em] wm-gold', lg ? 'text-sm' : 'text-[0.62rem]']}>Freshness Delivered Worldwide</span>}
  </span>
</span>

<style>
  /* Letter-spacing adds space after the last letter; pull it back so "Sea Food Exports" sits dead centre. */
  .tag-word { margin-right: -0.24em; }
  .is-lg .tag-word { margin-right: -0.26em; }
</style>
