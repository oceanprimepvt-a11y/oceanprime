---
// Enquiry list: the B2B answer to a shop cart. Buyers collect species from the catalogue,
// add a quantity to each, then send the whole list on WhatsApp or by email. No backend:
// the list lives in this browser only (localStorage, wrapped so a blocked store just means no memory).
import Icon from './Icon.astro';
---
<button id="enq-fab" type="button" hidden aria-haspopup="dialog" aria-controls="enq-dialog"
  class="fixed right-4 bottom-[calc(5.25rem+env(safe-area-inset-bottom))] z-30 inline-flex min-h-12 items-center gap-2.5 rounded-full bg-navy py-2.5 pl-4 pr-2.5 font-semibold text-white shadow-[0_14px_34px_-12px_rgb(11_26_46/.6)] ring-1 ring-white/10 transition-transform duration-200 ease-[var(--ease-out-expo)] hover:-translate-y-0.5 active:scale-[.97] md:right-6 md:bottom-6 dark:bg-gold dark:text-navy dark:ring-0">
  <Icon name="clipboard" size={20} />
  <span>Enquiry list</span>
  <span id="enq-count" class="grid min-w-7 place-items-center rounded-full bg-gold px-1.5 py-0.5 text-sm font-bold text-navy dark:bg-navy dark:text-gold">0</span>
</button>

<div id="enq-toast" role="status" aria-live="polite"
  class="pointer-events-none fixed left-1/2 bottom-[calc(12.75rem+env(safe-area-inset-bottom))] z-40 -translate-x-1/2 translate-y-2 rounded-full bg-ink px-4 py-2.5 text-sm font-medium whitespace-nowrap text-bg opacity-0 shadow-lg transition-[opacity,transform] duration-300 ease-[var(--ease-out-expo)] md:bottom-24 data-[show]:translate-y-0 data-[show]:opacity-100"></div>

<dialog id="enq-dialog" aria-labelledby="enq-title" class="enq-sheet m-0 bg-bg text-ink">
  <form method="dialog" class="flex h-full flex-col" novalidate id="enq-form">
    <header class="flex items-center justify-between gap-4 border-b border-line px-5 py-4 md:px-6">
      <div>
        <h2 id="enq-title" class="font-display text-2xl font-semibold">Your enquiry list</h2>
        <p class="text-sm text-ink-2">Add a quantity to each item, then send it to us.</p>
      </div>
      <button value="close" class="grid size-11 shrink-0 place-items-center rounded-full border border-line transition-colors hover:border-ink-2" aria-label="Close enquiry list">
        <Icon name="x" size={20} />
      </button>
    </header>

    <div class="flex-1 overflow-y-auto px-5 py-5 md:px-6">
      <ol id="enq-items" class="grid gap-3"></ol>
      <div id="enq-empty" class="grid place-items-center gap-3 rounded-card border border-dashed border-line px-6 py-12 text-center">
        <Icon name="clipboard" size={32} class="text-gold-ink" />
        <p class="font-semibold">Your list is empty.</p>
        <p class="max-w-xs text-sm text-ink-2">Use "Add to enquiry" on any product to collect the species you want priced together.</p>
        <a href="/products" class="btn btn-line mt-2">View products<Icon name="arrowRight" size={18} /></a>
      </div>

      <div id="enq-details" class="mt-6 grid gap-4 border-t border-line pt-6">
        <div class="grid gap-2">
          <label for="enq-name" class="text-sm font-semibold">Your name <span class="text-gold-ink">*</span></label>
          <input id="enq-name" name="name" class="field" autocomplete="name" />
        </div>
        <div class="grid gap-2">
          <label for="enq-company" class="text-sm font-semibold">Company</label>
          <input id="enq-company" name="company" class="field" autocomplete="organization" />
        </div>
        <div class="grid gap-2">
          <label for="enq-port" class="text-sm font-semibold">Destination port</label>
          <input id="enq-port" name="port" class="field" placeholder="For example: Jebel Ali, UAE" />
        </div>
        <p id="enq-error" class="hidden rounded-field border border-[#c2412d]/40 bg-[#c2412d]/10 px-4 py-3 text-sm font-medium text-[#a3321f] dark:text-[#ffb4a6]" role="alert"></p>
      </div>
    </div>

    <footer id="enq-actions" class="grid gap-3 border-t border-line px-5 pt-4 pb-[calc(1rem+env(safe-area-inset-bottom))] md:px-6">
      <button type="submit" value="whatsapp" class="btn btn-gold"><Icon name="whatsapp" size={20} />Send on WhatsApp</button>
      <button type="submit" value="email" class="btn btn-line"><Icon name="envelope" size={20} />Send by email</button>
    </footer>
  </form>
</dialog>

<style is:global>
  /* Bottom sheet on phones, right-hand drawer from md up. */
  .enq-sheet {
    position: fixed; inset: auto 0 0 0; width: 100%; max-width: 100%; height: min(88dvh, 44rem); max-height: none;
    border-radius: 22px 22px 0 0; border: 1px solid var(--c-line); padding: 0;
    transition: transform .35s var(--ease-out-expo), opacity .25s, overlay .35s allow-discrete, display .35s allow-discrete;
    transform: translateY(100%);
  }
  .enq-sheet[open] { transform: none; }
  @starting-style { .enq-sheet[open] { transform: translateY(100%); } }
  .enq-sheet::backdrop { background: rgb(6 14 26 / .55); backdrop-filter: blur(2px); transition: opacity .3s, overlay .3s allow-discrete, display .3s allow-discrete; opacity: 0; }
  .enq-sheet[open]::backdrop { opacity: 1; }
  @starting-style { .enq-sheet[open]::backdrop { opacity: 0; } }
  @media (min-width: 768px) {
    .enq-sheet { inset: 0 0 0 auto; width: 28rem; height: 100dvh; border-radius: 0; border-width: 0 0 0 1px; transform: translateX(100%); }
    @starting-style { .enq-sheet[open] { transform: translateX(100%); } }
  }
  @media (prefers-reduced-motion: reduce) { .enq-sheet, .enq-sheet::backdrop { transition: none; } }
</style>

<script>
  import { business } from '../data/site';

  type Item = { slug: string; name: string; qty: string };
  const KEY = 'op-enquiry';
  const load = (): Item[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
  const save = () => { try { localStorage.setItem(KEY, JSON.stringify(items)); } catch { /* storage blocked: list lasts this page only */ } };
  let items = load();

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const fab = $<HTMLButtonElement>('enq-fab');
  const count = $('enq-count');
  const dialog = $<HTMLDialogElement>('enq-dialog');
  const form = $<HTMLFormElement>('enq-form');
  const list = $('enq-items');
  const empty = $('enq-empty');
  const details = $('enq-details');
  const actions = $('enq-actions');
  const error = $('enq-error');
  const toast = $('enq-toast');
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  let toastTimer = 0;
  const say = (msg: string) => {
    toast.textContent = msg;
    toast.toggleAttribute('data-show', true);
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.removeAttribute('data-show'), 2400);
  };

  const render = () => {
    count.textContent = String(items.length);
    fab.hidden = items.length === 0;
    fab.setAttribute('aria-label', `Enquiry list, ${items.length} item${items.length === 1 ? '' : 's'}`);
    empty.hidden = items.length > 0;
    details.hidden = actions.hidden = items.length === 0;
    list.innerHTML = items.map((it, i) => `
      <li class="rounded-card border border-line bg-surface p-4">
        <div class="flex items-start justify-between gap-3">
          <a href="/products/${esc(it.slug)}" class="font-semibold leading-snug hover:underline">${esc(it.name)}</a>
          <button type="button" data-enq-remove="${esc(it.slug)}" class="-mt-1 -mr-1 grid size-9 shrink-0 place-items-center rounded-full text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink" aria-label="Remove ${esc(it.name)}">
            <svg width="18" height="18" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M205.66 194.34a8 8 0 0 1-11.32 11.32L128 139.31l-66.34 66.35a8 8 0 0 1-11.32-11.32L116.69 128L50.34 61.66a8 8 0 0 1 11.32-11.32L128 116.69l66.34-66.35a8 8 0 0 1 11.32 11.32L139.31 128Z"/></svg>
          </button>
        </div>
        <label for="enq-q-${i}" class="mt-3 block text-xs font-semibold uppercase tracking-[0.12em] text-ink-2">Quantity</label>
        <input id="enq-q-${i}" data-enq-qty="${esc(it.slug)}" value="${esc(it.qty)}" class="field mt-1.5" placeholder="For example: 5 MT or one 40 ft reefer" />
      </li>`).join('');
    document.querySelectorAll<HTMLButtonElement>('[data-enq-add]').forEach((b) => {
      const on = items.some((it) => it.slug === b.dataset.slug);
      b.setAttribute('aria-pressed', String(on));
      const label = b.querySelector('[data-label]');
      if (label) label.textContent = on ? 'Added' : (b.dataset.labelOff ?? 'Add to enquiry');
    });
  };

  // Add or remove from any page (product cards and product pages carry data-enq-add).
  document.addEventListener('click', (e) => {
    const add = (e.target as Element).closest<HTMLButtonElement>('[data-enq-add]');
    if (add) {
      const { slug = '', name = '' } = add.dataset;
      const i = items.findIndex((it) => it.slug === slug);
      if (i >= 0) { items.splice(i, 1); say(`${name} removed from your enquiry list`); }
      else { items.push({ slug, name, qty: '' }); say(`${name} added to your enquiry list`); }
      save(); render();
      return;
    }
    const rm = (e.target as Element).closest<HTMLButtonElement>('[data-enq-remove]');
    if (rm) {
      items = items.filter((it) => it.slug !== rm.dataset.enqRemove);
      save(); render();
      (list.querySelector('input') ?? form.querySelector<HTMLElement>('button[value="close"]'))?.focus();
    }
  });

  list.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    const it = items.find((x) => x.slug === input.dataset.enqQty);
    if (it) { it.qty = input.value; save(); }
  });

  fab.addEventListener('click', () => { render(); dialog.showModal(); });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); }); // backdrop click

  form.addEventListener('submit', (e) => {
    const via = (e.submitter as HTMLButtonElement | null)?.value;
    if (via !== 'whatsapp' && via !== 'email') return; // the close button
    e.preventDefault();
    const v = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement).value || '').trim();
    const nameField = form.elements.namedItem('name') as HTMLInputElement;
    nameField.removeAttribute('aria-invalid');
    if (!v('name')) {
      nameField.setAttribute('aria-invalid', 'true');
      error.textContent = 'Please add your name.';
      error.classList.remove('hidden');
      nameField.focus();
      return;
    }
    error.classList.add('hidden');

    const body = [
      'Enquiry list from the Ocean Prime website',
      `Name: ${v('name')}`,
      v('company') ? `Company: ${v('company')}` : null,
      v('port') ? `Destination port: ${v('port')}` : null,
      '',
      'Products:',
      ...items.map((it, i) => `${i + 1}. ${it.name}${it.qty.trim() ? `: ${it.qty.trim()}` : ''}`),
    ].filter((l) => l !== null).join('\n');

    if (via === 'email') {
      location.href = `mailto:${business.email}?subject=${encodeURIComponent(`Enquiry: ${items.length} product${items.length === 1 ? '' : 's'}`)}&body=${encodeURIComponent(body)}`;
    } else {
      window.open(`https://wa.me/${business.whatsapp}?text=${encodeURIComponent(body)}`, '_blank', 'noopener');
    }
  });

  render();
</script>
