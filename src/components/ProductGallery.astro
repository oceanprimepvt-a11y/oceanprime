---
// Product photo with a full-screen zoom. Extra photos named <image>-2, <image>-3 ... in src/assets/photos
// turn it into a gallery with thumbnails (none exist until the client's real photos arrive).
import { Picture, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { photosFor } from '../data/photos';

interface Props { image: string; alt: string }
const { image, alt } = Astro.props;
const pics = photosFor(image);
const large = await Promise.all(pics.map((src) => getImage({ src, width: Math.min(1600, src.width), format: 'webp' })));
const many = pics.length > 1;
---

<div data-gallery>
  <div class="overflow-hidden rounded-card bg-navy">
    {pics.map((src, i) => (
      <button type="button" class="pg-main group relative block w-full cursor-zoom-in" data-zoom-open={i} hidden={i > 0} aria-haspopup="dialog">
        <Picture
          src={src}
          alt={many ? `${alt}, photo ${i + 1} of ${pics.length}` : alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 680px, 100vw"
          formats={['avif', 'webp']}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-[var(--ease-out-expo)] group-hover:scale-[1.03]"
        />
        <span class="pg-hint absolute bottom-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-navy/75 px-3 py-1.5 text-sm font-medium text-white backdrop-blur-sm">
          <Icon name="zoom" size={16} />Tap to zoom
        </span>
      </button>
    ))}
  </div>

  {many && (
    <div class="mt-3 flex gap-2 overflow-x-auto" role="group" aria-label="Photos">
      {pics.map((src, i) => (
        <button type="button" class="pg-thumb shrink-0 overflow-hidden rounded-field ring-2 ring-transparent aria-pressed:ring-gold" data-thumb={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Photo ${i + 1}`}>
          <Picture src={src} alt="" widths={[160]} sizes="5rem" formats={['avif', 'webp']} class="aspect-[3/2] w-20 object-cover" />
        </button>
      ))}
    </div>
  )}

  <dialog class="pz" data-zoom aria-label={`${alt}, larger photo`}>
    <div class="pz-stage" data-zoom-stage>
      {large.map((l, i) => (
        <img src={l.src} width={l.attributes.width} height={l.attributes.height} alt={alt} data-zoom-img={i} hidden loading="lazy" decoding="async" draggable="false" />
      ))}
    </div>
    <p class="pz-tip">Tap the photo to zoom in. Drag to look around.</p>
    <button type="button" class="pz-close" data-zoom-close aria-label="Close larger photo"><Icon name="x" size={22} /></button>
  </dialog>
</div>

<style>
  .pz {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgb(4 10 19 / .95); color: #fff; overscroll-behavior: contain;
  }
  .pz::backdrop { background: transparent; }
  :global(html:has(.pz[open])) { overflow: hidden; }
  .pz-stage { position: absolute; inset: 0; display: grid; place-items: center; overflow: hidden; padding: 3.5rem 1rem; }
  .pz-stage img { max-width: 100%; max-height: 100%; object-fit: contain; cursor: zoom-in; user-select: none; }
  .pz-stage[data-zoomed] { display: block; overflow: auto; padding: 0; scrollbar-width: none; }
  .pz-stage[data-zoomed] img { max-width: none; max-height: none; width: 250%; cursor: grab; }
  @media (min-width: 1024px) { .pz-stage[data-zoomed] img { width: 180%; } }
  .pz-stage[data-zoomed].is-drag img { cursor: grabbing; }
  .pz-close {
    position: absolute; top: max(.75rem, env(safe-area-inset-top)); right: .75rem; display: grid; place-items: center;
    width: 3rem; height: 3rem; border-radius: 999px; background: rgb(255 255 255 / .12); color: #fff;
  }
  .pz-close:hover { background: rgb(255 255 255 / .22); }
  .pz-close:focus-visible, .pg-main:focus-visible, .pg-thumb:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 3px; }
  .pz-tip {
    position: absolute; left: 50%; bottom: max(1rem, env(safe-area-inset-bottom)); translate: -50% 0; margin: 0;
    padding: .45rem .9rem; border-radius: 999px; background: rgb(255 255 255 / .1); font-size: .85rem; white-space: nowrap; pointer-events: none;
  }
  .pz-stage[data-zoomed] ~ .pz-tip { opacity: 0; }
  @media (prefers-reduced-motion: no-preference) {
    .pz[open] { animation: pz-in .3s var(--ease-out-expo); }
    .pz-tip { transition: opacity .3s; }
  }
  @keyframes pz-in { from { opacity: 0; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const dialog = g.querySelector<HTMLDialogElement>('[data-zoom]')!;
    const stage = g.querySelector<HTMLElement>('[data-zoom-stage]')!;
    const mains = [...g.querySelectorAll<HTMLButtonElement>('[data-zoom-open]')];
    const imgs = [...g.querySelectorAll<HTMLImageElement>('[data-zoom-img]')];
    let opener: HTMLElement | null = null;

    const unzoom = () => stage.removeAttribute('data-zoomed');
    mains.forEach((b, i) => b.addEventListener('click', () => {
      imgs.forEach((im, j) => (im.hidden = j !== i));
      unzoom();
      opener = b;
      dialog.showModal();
    }));
    g.querySelectorAll<HTMLButtonElement>('[data-thumb]').forEach((t) => t.addEventListener('click', () => {
      const i = +t.dataset.thumb!;
      mains.forEach((m, j) => (m.hidden = j !== i));
      g.querySelectorAll('[data-thumb]').forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
    }));
    g.querySelector('[data-zoom-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => { unzoom(); opener?.focus(); });

    // Tap the photo to zoom in at that point, tap again to zoom out. A tap on the dark area closes.
    let drag: { x: number; y: number; l: number; t: number; moved: boolean } | null = null;
    stage.addEventListener('click', (e) => {
      if (drag?.moved) return;
      const img = (e.target as Element).closest('img');
      if (!img) { dialog.close(); return; }
      if (stage.hasAttribute('data-zoomed')) { unzoom(); return; }
      const r = img.getBoundingClientRect();
      const fx = (e.clientX - r.left) / r.width, fy = (e.clientY - r.top) / r.height;
      stage.setAttribute('data-zoomed', '');
      stage.scrollLeft = fx * img.offsetWidth - stage.clientWidth / 2;
      stage.scrollTop = fy * img.offsetHeight - stage.clientHeight / 2;
    });
    // Mouse drag pans the zoomed photo (touch already scrolls natively).
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || !stage.hasAttribute('data-zoomed')) { drag = null; return; }
      drag = { x: e.clientX, y: e.clientY, l: stage.scrollLeft, t: stage.scrollTop, moved: false };
    });
    stage.addEventListener('pointermove', (e) => {
      if (!drag || !(e.buttons & 1)) return;
      const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
      if (!drag.moved && Math.hypot(dx, dy) < 5) return;
      drag.moved = true;
      stage.classList.add('is-drag');
      stage.scrollLeft = drag.l - dx; stage.scrollTop = drag.t - dy;
    });
    addEventListener('pointerup', () => {
      stage.classList.remove('is-drag');
      // Let the click that ends a drag see `moved`, then forget the drag.
      setTimeout(() => (drag = null));
    });
  });
</script>
