---
import { Picture } from 'astro:assets';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { photo } from '../data/photos';
import { nav, business, tel, waLink } from '../data/site';

// Static builds can report "/index.html" for the home page, so strip that as well as the trailing slash.
const path = Astro.url.pathname.replace(/\/?(index)?(\.html)?$/, '');
const isActive = (href: string) => (href === '/' ? path === '' : path === href || path.startsWith(`${href}/`));

// Menu thumbnails: one photo per destination, so each row reads at a glance.
const thumbs: Record<string, string> = { '/': 'hero', '/products': 'vannamei', '/process': 'processing', '/about': 'harbour', '/contact': 'cartons' };
const menuLinks = [{ href: '/', label: 'Home' }, ...nav];
---
<!-- Floating glass pill. Outer padding + pill height = 4rem / 4.5rem, the offset sticky bars rely on. -->
<header class="site-header sticky top-0 z-40 px-2 pt-2 md:px-4 md:pt-3">
  <div class="site-pill mx-auto flex h-14 max-w-[80rem] items-center justify-between gap-4 rounded-full border border-line/80 bg-bg/75 pl-1.5 pr-1.5 backdrop-blur-xl md:h-[3.75rem] md:pl-2 md:pr-2">
    <a href="/" class="flex items-center rounded-full py-1 pl-2 pr-2 md:pl-2.5">
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {menuLinks.map((n) => (
          <li>
            <a
              href={n.href}
              aria-current={isActive(n.href) ? 'page' : undefined}
              class="rounded-full px-2.5 py-2 text-[0.95rem] lg:px-4 font-medium text-ink-2 transition-colors hover:text-ink aria-[current=page]:bg-surface-2 aria-[current=page]:text-ink"
            >{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1.5">
      <button type="button" data-theme-toggle class="grid size-11 place-items-center rounded-full text-ink-2 transition-colors hover:bg-surface-2 hover:text-ink" aria-label="Switch colour theme">
        <Icon name="moon" size={20} class="dark:hidden" />
        <Icon name="sun" size={20} class="hidden dark:block" />
      </button>
      <a href="/quote" class="btn btn-gold hidden lg:inline-flex">Request a quote</a>
      <button
        type="button"
        data-menu-open
        class="grid size-11 place-items-center rounded-full bg-navy text-white dark:bg-gold dark:text-navy md:hidden"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon name="list" size={22} />
      </button>
    </div>
  </div>

  <!-- Mobile menu: a native dialog gives focus trapping, Esc to close and an inert page for free. -->
  <dialog id="mobile-menu" class="menu deep-water m-0 h-dvh max-h-none w-full max-w-none p-0 text-white backdrop:bg-transparent md:hidden" aria-label="Menu">
    <div class="on-dark flex h-full flex-col overflow-y-auto">
      <div class="flex h-16 shrink-0 items-center justify-between px-3.5 pt-2">
        <Logo tone="dark" />
        <button type="button" data-menu-close class="grid size-11 place-items-center rounded-full border border-white/15 bg-white/5 text-white" aria-label="Close menu">
          <Icon name="x" size={22} />
        </button>
      </div>

      <div class="container-x mt-5 flex items-center justify-between text-xs font-semibold uppercase tracking-[0.16em] text-white/60">
        <span>Menu</span>
        <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={14} class="text-gold" />Vizag <time data-vizag-time class="tabular-nums text-white">IST</time></span>
      </div>

      <nav aria-label="Mobile" class="container-x mt-3">
        <ul class="border-t border-white/12">
          {menuLinks.map((n, i) => (
            <li class="menu-item border-b border-white/12" style={`--i:${i}`}>
              <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined} class="group flex items-center gap-4 py-2.5">
                <span class="w-7 text-sm font-semibold tabular-nums text-white/45 m-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1 font-display text-[2rem] font-semibold leading-none tracking-[-0.03em] m-label">
                  {n.label}
                </span>
                <Picture
                  src={photo(thumbs[n.href] ?? 'hero')}
                  alt=""
                  widths={[96, 192]}
                  sizes="64px"
                  formats={['avif', 'webp']}
                  class="menu-thumb size-12 rounded-[12px] object-cover ring-1 ring-white/15"
                />
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="container-x mt-auto pt-8">
        <p class="menu-item text-xs font-semibold uppercase tracking-[0.16em] text-white/60" style="--i:5">Talk to the export desk</p>
        <ul class="menu-item glass-tile mt-3 divide-y divide-white/10 hover:bg-white/5" style="--i:6">
          {business.phones.map((p) => (
            <li>
              <a href={tel(p)} class="flex min-h-12 items-center gap-3 px-4 py-2.5 transition-colors hover:text-gold">
                <Icon name="phone" size={18} class="shrink-0 text-gold" />
                <span class="flex-1 font-semibold tabular-nums">{p}</span>
                <span class="text-xs font-semibold uppercase tracking-[0.14em] text-white/55">Call</span>
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${business.email}`} class="flex min-h-12 items-center gap-3 px-4 py-2.5 font-medium transition-colors hover:text-gold">
              <Icon name="envelope" size={18} class="shrink-0 text-gold" />
              <span class="flex-1 truncate">{business.email}</span>
              <span class="text-xs font-semibold uppercase tracking-[0.14em] text-white/55">Email</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="menu-item container-x grid grid-cols-2 gap-3 pb-[calc(1.25rem+env(safe-area-inset-bottom))] pt-4" style="--i:7">
        <a href="/quote" class="btn btn-gold px-4">Request a quote</a>
        <a href={waLink()} class="btn btn-ghost-light px-4" target="_blank" rel="noopener"><Icon name="whatsapp" size={20} />WhatsApp us</a>
      </div>
    </div>
  </dialog>
</header>

<style>
  .site-pill { box-shadow: 0 10px 30px -18px rgb(11 26 46 / .45); transition: background-color .3s, box-shadow .3s; }
  :global([data-theme='dark']) .site-pill { box-shadow: 0 10px 30px -14px rgb(0 0 0 / .7); }
  /* Once the page scrolls, the pill firms up so it reads over busy photos. */
  .site-header[data-scrolled] .site-pill { background-color: color-mix(in oklab, var(--c-bg) 92%, transparent); box-shadow: 0 16px 40px -18px rgb(11 26 46 / .55); }

  /* Current page: gold number, gold label, gold ring on the thumbnail. */
  .menu a[aria-current='page'] .m-num, .menu a[aria-current='page'] .m-label { color: var(--color-gold); }
  .menu a[aria-current='page'] :global(img) { box-shadow: 0 0 0 2px var(--color-gold); }

  @media (prefers-reduced-motion: no-preference) {
    .menu { opacity: 0; transition: opacity .3s var(--ease-out-expo), overlay .3s allow-discrete, display .3s allow-discrete; }
    .menu[open] { opacity: 1; }
    @starting-style { .menu[open] { opacity: 0; } }
    .menu[open] .menu-item { animation: menu-rise .6s var(--ease-out-expo) both; animation-delay: calc(var(--i) * 50ms + 80ms); }
    .menu[open] .menu-thumb { animation: thumb-in .7s var(--ease-out-expo) both; animation-delay: inherit; }
    @keyframes menu-rise { from { opacity: 0; transform: translateY(14px); } }
    @keyframes thumb-in { from { opacity: 0; transform: scale(.8) rotate(-4deg); } }
  }
</style>

<script>
  const root = document.documentElement;
  const header = document.querySelector<HTMLElement>('.site-header');
  const onScroll = () => header?.toggleAttribute('data-scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
  document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });

  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');

  // Live time at the harbour: buyers in other time zones see when the desk is awake.
  const clock = menu?.querySelector<HTMLTimeElement>('[data-vizag-time]');
  const fmt = new Intl.DateTimeFormat('en-IN', { timeZone: 'Asia/Kolkata', hour: 'numeric', minute: '2-digit' });
  let timer = 0;
  const tick = () => { if (clock) clock.textContent = `${fmt.format(new Date())} IST`; };

  opener?.addEventListener('click', () => {
    tick();
    timer = window.setInterval(tick, 20000);
    menu?.showModal();
    opener.setAttribute('aria-expanded', 'true');
  });
  menu?.addEventListener('close', () => { clearInterval(timer); opener?.setAttribute('aria-expanded', 'false'); });
  menu?.querySelector('[data-menu-close]')?.addEventListener('click', () => menu.close());
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => { if (e.matches) menu?.close(); });
</script>
