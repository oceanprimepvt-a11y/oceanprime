---
import Icon from './Icon.astro';
// Back-to-top button with a gold ring that fills as the page scrolls.
// Sits on the right above the phone bar, and steps up when the enquiry button is showing.
---
<a href="#main" id="to-top" aria-label="Back to top" data-hidden
  class="to-top fixed right-4 bottom-[calc(5.25rem+env(safe-area-inset-bottom))] z-30 grid size-12 place-items-center rounded-full bg-surface text-ink shadow-[0_14px_34px_-14px_rgb(11_26_46/.55)] ring-1 ring-line transition-[translate,opacity,scale,bottom] duration-300 ease-[var(--ease-out-expo)] hover:-translate-y-0.5 active:scale-95 md:right-6 md:bottom-6">
  <svg class="pointer-events-none absolute inset-0 -rotate-90" viewBox="0 0 48 48" aria-hidden="true">
    <circle cx="24" cy="24" r="22.5" fill="none" stroke="var(--color-gold)" stroke-width="2.5" stroke-linecap="round" pathLength="100" stroke-dasharray="100" style="stroke-dashoffset: calc(100 - var(--p, 0) * 100)" />
  </svg>
  <Icon name="arrowUp" size={20} />
</a>

<style>
  .to-top[data-hidden] { opacity: 0; translate: 0 12px; scale: .9; pointer-events: none; visibility: hidden; transition-property: translate, opacity, scale, bottom, visibility; }
  .to-top:focus-visible { outline: 2px solid var(--color-gold); outline-offset: 3px; }
  /* Enquiry button visible: stack above it instead of covering it. */
  :global(body:has(#enq-fab:not([hidden]))) .to-top { bottom: calc(9rem + env(safe-area-inset-bottom)); }
  @media (min-width: 768px) {
    :global(body:has(#enq-fab:not([hidden]))) .to-top { bottom: 5.25rem; }
  }
  @media (prefers-reduced-motion: reduce) { .to-top { transition: none; } }
</style>

<script>
  const btn = document.getElementById('to-top')!;
  let ticking = false;
  const update = () => {
    ticking = false;
    const max = document.documentElement.scrollHeight - innerHeight;
    btn.style.setProperty('--p', String(max > 0 ? Math.min(scrollY / max, 1) : 0));
    btn.toggleAttribute('data-hidden', scrollY < innerHeight * 0.6);
  };
  addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
  addEventListener('resize', update);
  update();
  btn.addEventListener('click', (e) => {
    e.preventDefault();
    // scroll-behavior: smooth (motion allowed) or an instant jump (reduced motion), then focus the page start.
    // Focus moves only after the scroll ends: focusing mid-scroll cancels Chrome's smooth scroll.
    const main = document.getElementById('main');
    const done = () => main?.focus({ preventScroll: true });
    if ('onscrollend' in window) addEventListener('scrollend', done, { once: true }); else setTimeout(done, 600);
    scrollTo({ top: 0 });
  });
</script>
