---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SpecBuilder from '../components/SpecBuilder.astro';
import { business, tel, waLink } from '../data/site';
---
<BaseLayout
  title="Spec builder: request a quote"
  description={`Build your seafood spec with ${business.name}, Visakhapatnam: species, form, size grade, freezing, glaze, packing, quantity and port. Send it on WhatsApp or by email, or print the spec sheet.`}
  crumbs={[{ name: 'Spec builder', href: '/quote' }]}
>
  <section class="container-x pb-8 pt-12 md:pb-10 md:pt-20">
    <nav aria-label="Breadcrumb" class="text-sm text-ink-2"><a href="/" class="hover:text-ink">Home</a><span class="mx-2" aria-hidden="true">/</span><span aria-current="page">Spec builder</span></nav>
    <h1 class="mt-4 max-w-3xl text-5xl font-bold leading-[1] tracking-[-0.035em] md:text-7xl">Build your spec. Get your quote.</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-2">Choose each detail the way your market buys it. Your spec sheet fills in as you go, and you send it to the export desk in one tap. Skip anything you are unsure of and we will advise.</p>
  </section>

  <div class="container-x pb-16 md:pb-24">
    <SpecBuilder mode="page" />
  </div>

  <section class="container-x pb-20 md:pb-28">
    <div class="flex flex-col gap-5 rounded-card border border-line bg-surface p-6 md:flex-row md:items-center md:justify-between md:p-8">
      <div>
        <h2 class="font-display text-2xl font-semibold">Rather talk it through?</h2>
        <p class="mt-1.5 text-ink-2">Call or message the export desk in {business.city}, or write to us in your own words.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={waLink()} target="_blank" rel="noopener" class="btn btn-line"><Icon name="whatsapp" size={20} />WhatsApp</a>
        <a href={tel(business.phones[0])} class="btn btn-line"><Icon name="phone" size={20} />Call</a>
        <a href="/contact" class="btn btn-line">Contact form<Icon name="arrowRight" size={18} /></a>
      </div>
    </div>
  </section>
</BaseLayout>
